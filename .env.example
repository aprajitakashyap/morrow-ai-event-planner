# Morrow works without any AI key. Leave these blank to use guided mode.
# Add one provider to turn on the creative layer and the AI copilot.

# Google Gemini (default provider when GEMINI_API_KEY is set)
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Any OpenAI-compatible endpoint. AI_BASE_URL should end at the API root,
# for example https://api.example.com/v1 — Morrow appends /chat/completions.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
